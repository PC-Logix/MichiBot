{
  "channels": [
    "#example"
  ],
  "server": "irc.example.net",
  "userName": "examplebot",
  "realName": "Example IRC Bot",
  "port": 6697,
  "debug": false,
  "showErrors": false,
  "autoRejoin": true,
  "autoConnect": false,
  "secure": true,
  "selfSigned": false,
  "certExpired": false,
  "floodProtection": true,
  "floodProtectionDelay": 1000,
  "sasl": false,
  "commandPrefix": "#",
  "bridges": {
    "discord": {
      "enabled": false,
      "ircNicks": [
        "ExampleBridgeUser"
      ],
      "pattern": "^<([^>]+)>\\s+(.+)$",
      "auth": {
        "enabled": false,
        "lookupUrl": "https://example.com/resolve-user-id",
        "method": "POST",
        "timeoutMs": 3000,
        "headerName": "x-example-secret",
        "headerValue": "change-me",
        "cacheTtlMs": 300000,
        "failureCacheTtlMs": 30000,
        "transportIdentity": {
          "enabled": true,
          "allowedNicks": [
            "ExampleBridgeUser"
          ],
          "allowedAccounts": [
            "ExampleBridgeUser"
          ],
          "allowWhoisFallback": true,
          "whoisTimeoutMs": 2000
        }
      }
    }
  },
  "http": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8080,
    "baseDomain": "http://localhost:8080"
  },
  "dynamicCommands": {
    "webWrites": false
  },
  "integrations": {
    "github": {
      "token": ""
    },
    "youtube": {
      "apiKey": ""
    }
  },
  "rpg": {
    "story": "crossroads",
    "activity": {
      "enabled": true,
      "xp": 0.25,
      "cooldownSeconds": 60,
      "minLength": 3
    }
  },
  "luaSandbox": {
    "timeoutMs": 3500,
    "maxMessageLength": 420,
    "maxOutputLength": 2000
  },
  "jsSandbox": {
    "timeoutMs": 1000,
    "maxMessageLength": 420,
    "maxOutputLength": 2000,
    "maxScriptLength": 8000
  },
  "auth": {
    "sasl": {
      "enabled": false,
      "account": "",
      "password": "",
      "mechanism": "PLAIN",
      "disconnectOnFail": true
    },
    "seedWhoisOnJoin": false,
    "whoisOnJoin": false,
    "whoisQueueDelayMs": 2500,
    "whoisTimeoutMs": 2500,
    "maxSeedWhoisPerChannel": 5
  }
}
